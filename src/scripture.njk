---
layout: base.njk
bodyClass: inbox
title: Scripture Index
summary: Every verse Buddy cites, Genesis to Revelation, linked to the devos that quote it.
permalink: /scripture/
eleventyExcludeFromCollections: true
---
<main class="screen screen-list">
  <header class="list-head">
    <div class="list-head-text">
      <p class="crumb"><a href="/">&larr; All devos</a></p>
      <h1>Scripture</h1>
      <p class="list-sub">{{ scriptureIndex.refCount }} references from {{ scriptureIndex.bookCount }} of {{ scriptureIndex.bookTotal }} books, Genesis to Revelation</p>
    </div>
    {% include "theme-toggle.njk" %}
  </header>

  {# Book grid: a group per division of the Bible, a labelled square per
     book, in canonical order. All 66 are drawn, not just the ones he cites
     -- the empties are what make the shape of his reading legible, and only
     a cited book is filled in.

     Unlike the activity graph on the home page this is not hidden until the
     script takes over, because there is no script: every filled square is a
     real anchor link to a section of this page, which the browser handles
     natively and which therefore survives JS being off. #}
  <nav class="bgrid" aria-label="Books of the Bible. Select a book to jump to its references.">
    {%- for d in scriptureIndex.divisions %}
    <div class="bdiv">
      <span class="bdiv-name" aria-hidden="true">{{ d.name }}</span>
      <div class="bdiv-books">
        {%- for b in d.books %}
        {%- if b.cited %}
        <a class="bsq bsq-on" href="#{{ b.slug }}"
           title="{{ b.label }}" aria-label="{{ b.label }}">{{ b.abbr }}</a>
        {%- else %}
        <span class="bsq" role="img" title="{{ b.label }}"
              aria-label="{{ b.label }}">{{ b.abbr }}</span>
        {%- endif %}
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </nav>

  {% for b in scriptureIndex.books %}
  <section class="book" id="{{ b.slug }}">
    <h2 class="book-name">{{ b.book }}</h2>
    <ul class="refs">
      {% for r in b.refs %}
      <li class="ref">
        {%- if r.devos | length == 1 %}
        {# One devo: the whole row is the link, so clicking the verse goes straight there. #}
        <a class="ref-row" href="{{ r.devos[0].url }}">
          <span class="ref-label">{{ r.label }}</span>
          <span class="ref-devo">{{ r.devos[0].title }}</span>
          <span class="ref-date">{{ r.devos[0].date | shortDate }}</span>
        </a>
        {%- else %}
        {# Cited more than once, so each devo gets its own link. #}
        <div class="ref-row ref-row-multi">
          <span class="ref-label">{{ r.label }}</span>
          <span class="ref-many">
            {% for d in r.devos %}<a class="ref-devo-link" href="{{ d.url }}">{{ d.title }}<span class="ref-date">{{ d.date | shortDate }}</span></a>{% endfor %}
          </span>
        </div>
        {%- endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</main>

{% include "to-top.njk" %}
